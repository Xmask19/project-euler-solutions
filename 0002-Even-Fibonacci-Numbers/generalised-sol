"""Generalises the second problem to be able to take sum every mth fibonacci
number, starting on the rth."""


def fibonacci_multiples(limit: int, m: int, r: int):
    """
    Yield Fibonacci numbers F(k) where k ≡ r (mod m) and F(k) <= limit.
    r must be in [0, m-1]. F(0)=0
    """
    a, b = 0, 1
    k = 0
    while a <= limit:
        if k % m == r:
            yield a
        a, b = b, a + b
        k += 1


# Sum every 3rd Fibonacci starting at index 0 (i.e., F(0), F(3), F(6), ...)
# But F(0)=0, so this gives the even fibonacci numbers.
total = sum(fibonacci_multiples(4_000_000, 3, 0))
print(total)  # 4613732
